PORT=4100
SPREADSHEET_ID=

# Local use: keep this, pointing at your downloaded key file.
GOOGLE_KEY_FILE=service-account.json

# Hosted use (Render etc.): leave GOOGLE_KEY_FILE unset and instead paste the
# ENTIRE contents of service-account.json into this one line instead.
GOOGLE_CREDENTIALS_JSON=

# Hosted use only: set both to password-protect the whole site. Leave both
# blank for local use so there's no login prompt on your own PC.
AUTH_USER=
AUTH_PASS=
